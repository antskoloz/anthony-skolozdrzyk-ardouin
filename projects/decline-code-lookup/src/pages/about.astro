---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout
  title="About"
  description="Why this decline code lookup tool exists and who maintains it."
  path="/about/"
>
  <div class="wrap">
    <Breadcrumbs crumbs={[{ label: "Home", path: "/" }, { label: "About", path: "/about/" }]} />

    <h1>About this tool</h1>
    <p>
      Decline Code Lookup is a free educational resource for merchants — online and offline —
      who accept card payments and want to understand why a transaction was declined.
    </p>
    <p>
      Card networks like Visa, Mastercard, and American Express each use their own decline
      codes, and the messages merchants see at checkout rarely explain what's actually going
      wrong or what to do about it. This site translates those codes into plain English,
      grouped by cause, with concrete next steps for merchants.
    </p>
    <p>
      This is an independent, unaffiliated resource — it is not run or endorsed by Visa,
      Mastercard, American Express, or any card network, processor, or bank. It is not legal,
      financial, or compliance advice.
    </p>

    <CTA />
  </div>
</BaseLayout>
