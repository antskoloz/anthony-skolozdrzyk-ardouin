---
import type { CollectionEntry } from 'astro:content';
import BlogPostCard from './BlogPostCard.astro';
import { getPillarsForSlug } from '../data/blog-pillars';

interface Props {
  currentId: string;
  allLive: CollectionEntry<'blog'>[];
}

const { currentId, allLive } = Astro.props;
const pillars = getPillarsForSlug(currentId);
const current = allLive.find((p) => p.id === currentId);
const currentTags = new Set(current?.data.tags ?? []);

// Rank by relevance, not recency: shared tags first, then the curated order in
// blog-pillars.ts, so older posts that already rank keep getting linked.
const curatedRank = new Map<string, number>();
pillars.forEach((pillar) =>
  pillar.postSlugs.forEach((slug, i) => {
    if (!curatedRank.has(slug) || i < curatedRank.get(slug)!) curatedRank.set(slug, i);
  }),
);
curatedRank.delete(currentId);

const sharedTags = (p: CollectionEntry<'blog'>) => p.data.tags.filter((t) => currentTags.has(t)).length;
const related = allLive
  .filter((p) => curatedRank.has(p.id))
  .sort((a, b) => sharedTags(b) - sharedTags(a) || curatedRank.get(a.id)! - curatedRank.get(b.id)!)
  .slice(0, 3);
---

{related.length > 0 && (
  <section class="related-posts" aria-labelledby="related-posts-title">
    <h2 id="related-posts-title">More on this topic</h2>
    <div class="blog-grid">
      {related.map((post) => <BlogPostCard post={post} />)}
    </div>
  </section>
)}
