---
import { SITE_URL, SITE_TITLE, AUTHOR_NAME, AUTHOR_PERSON_ID } from '../consts';

interface Props {
  title: string;
  description: string;
  canonicalPath: string; // e.g. "/blog/" or "/blog/my-post/"
  ogImage?: string;
  article?: {
    pubDate: Date;
    updatedDate?: Date;
    tags: string[];
  };
}

const { title, description, canonicalPath, ogImage, article } = Astro.props;
const canonicalURL = `${SITE_URL}${canonicalPath}`;
const imageURL = ogImage ? `${SITE_URL}${ogImage}` : `${SITE_URL}/assets/img/headshot.jpg`;
const pageTitle = canonicalPath === '/blog/' ? `Blog | ${SITE_TITLE}` : `${title} | ${SITE_TITLE}`;

const articleJsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      '@id': `${canonicalURL}#article`,
      headline: title,
      description,
      datePublished: article.pubDate.toISOString(),
      ...(article.updatedDate ? { dateModified: article.updatedDate.toISOString() } : {}),
      url: canonicalURL,
      image: imageURL,
      keywords: article.tags.join(', '),
      author: { '@id': AUTHOR_PERSON_ID, name: AUTHOR_NAME },
      publisher: { '@id': AUTHOR_PERSON_ID, name: AUTHOR_NAME },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
    }
  : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{pageTitle}</title>
<meta name="description" content={description}>
<meta name="author" content={AUTHOR_NAME}>
<meta name="robots" content="index, follow">

<link rel="canonical" href={canonicalURL}>

<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={imageURL}>
<meta property="og:locale" content="en_US">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={imageURL}>

<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} — Blog`} href={`${SITE_URL}/rss.xml`}>

<link rel="icon" href={`${SITE_URL}/assets/img/favicon.svg`} type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href={`${SITE_URL}/assets/css/style.css`}>

{articleJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
)}

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QXP44186J4"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  // @ts-ignore
  gtag('js', new Date());
  // @ts-ignore
  gtag('config', 'G-QXP44186J4');
</script>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header">
  <div class="container">
    <a href={`${SITE_URL}/`} class="logo">
      <span class="logo-mark">AS</span>
      <span>Anthony Skolozdrzyk-Ardouin</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-links">
        <li><a href={`${SITE_URL}/#about`}>About</a></li>
        <li><a href={`${SITE_URL}/#experience`}>Experience</a></li>
        <li><a href={`${SITE_URL}/#skills`}>Skills</a></li>
        <li><a href={`${SITE_URL}/#projects`}>Projects</a></li>
        <li><a href={`${SITE_URL}/blog/`} aria-current={canonicalPath.startsWith('/blog/') ? 'true' : undefined}>Blog</a></li>
        <li><a href={`${SITE_URL}/#faq`}>FAQ</a></li>
        <li><a href={`${SITE_URL}/#contact`}>Contact</a></li>
      </ul>
      <div class="nav-actions">
        <a class="btn btn-primary btn-sm" href={`${SITE_URL}/#contact`}>Let's chat</a>
      </div>
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" aria-label="Mobile">
    <a href={`${SITE_URL}/#about`}>About</a>
    <a href={`${SITE_URL}/#experience`}>Experience</a>
    <a href={`${SITE_URL}/#skills`}>Skills</a>
    <a href={`${SITE_URL}/#projects`}>Projects</a>
    <a href={`${SITE_URL}/blog/`}>Blog</a>
    <a href={`${SITE_URL}/#faq`}>FAQ</a>
    <a href={`${SITE_URL}/#contact`}>Contact</a>
  </nav>
</header>

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div class="container">
    <a href={`${SITE_URL}/`} class="logo">
      <span class="logo-mark">AS</span>
      <span>Anthony Skolozdrzyk-Ardouin</span>
    </a>
    <ul class="footer-links">
      <li><a href={`${SITE_URL}/#about`}>About</a></li>
      <li><a href={`${SITE_URL}/#experience`}>Experience</a></li>
      <li><a href={`${SITE_URL}/blog/`}>Blog</a></li>
      <li><a href={`${SITE_URL}/#contact`}>Contact</a></li>
    </ul>
    <div class="footer-social">
      <a href="https://www.linkedin.com/in/anthony-skolozdrzyk-ardouin-data-analytics-expert" target="_blank" rel="noopener" aria-label="LinkedIn">
